rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) && 
             data.uid == request.auth.uid &&
             data.email is string &&
             data.createdAt == request.time;
    }
    
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'currency', 'updatedAt']);
    }
    
    function isValidGoal(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'targetAmount', 'currentAmount', 'createdAt', 'history']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 100 &&
             data.targetAmount is number &&
             data.currentAmount is number &&
             data.history is list &&
             data.createdAt == request.time;
    }
    
    match /goals/{goalId} {
      // List operation explicitly checks resource.data.userId == request.auth.uid
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidId(goalId) && isValidGoal(request.resource.data);
      
      // Allow updates to currentAmount, history, etc.
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'targetAmount', 'currentAmount', 'deadline', 'color', 'history', 'category']);
                    
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
